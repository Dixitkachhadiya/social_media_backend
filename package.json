{
  "name": "social-media-backend",
  "version": "1.0.0",
  "description": "Backend for the AI-Powered Social Media Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:undo": "node src/database/migrate.js down",
    "migrate:status": "node src/database/migrate.js status",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "ai:check": "node scripts/check-ollama.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "./tests/setupEnv.js"
    ],
    "globalSetup": "./tests/globalSetup.js",
    "testTimeout": 20000
  }
}
