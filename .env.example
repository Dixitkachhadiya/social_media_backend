PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/social_media_db
# Separate database for automated tests. Its name must contain "test" (e.g. social_media_test_db);
# "npm test" creates it if missing and applies migrations.
TEST_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/social_media_test_db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long_random_secret>
JWT_EXPIRES_IN=7d

# Browser origins allowed by CORS (REST API and Socket.IO), comma-separated, scheme + host (+ port), no path.
# Unknown origins are refused. If empty: development allows localhost:3000/5173, production allows nothing.
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# SMTP server for verification and password reset codes.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS), SMTP_USER=<full Gmail address>,
# SMTP_PASS=<16-character App Password> (requires 2-Step Verification:
# https://myaccount.google.com/apppasswords). Your normal Gmail password will not work.
SMTP_HOST=<smtp_host>
SMTP_PORT=587
SMTP_USER=<smtp_username>
SMTP_PASS=<smtp_password>
EMAIL_FROM="AI Social <no-reply@example.com>"
# Optional: brand name used in emails (default "AI Social")
APP_NAME=AI Social
# Optional: secret for hashing one-time codes (defaults to JWT_SECRET). Generate like JWT_SECRET.
OTP_SECRET=

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=<gemini_api_key>
# Optional: model name (defaults to gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Content moderation: our own local model (Backend/ai-moderation), started with "npm run moderation".
# Posts and comments are refused (503) while it is unreachable. No external AI API is used for moderation.
MODERATION_SERVICE_URL=http://127.0.0.1:8001
MODERATION_TIMEOUT_MS=5000
# Optional shared secret; when set, start the Python service with the same value
MODERATION_SERVICE_KEY=
