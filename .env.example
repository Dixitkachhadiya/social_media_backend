PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/social_media_db
# Separate database for automated tests. Its name must contain "test" (e.g. social_media_test_db);
# "npm test" creates it if missing and applies migrations.
TEST_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/social_media_test_db
# Database connections per backend process (default 4). Hosted plans cap connections per user
# (Clever Cloud free PostgreSQL: 5) and every process using the same credentials shares that cap.
DB_POOL_MAX=4

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long_random_secret>
JWT_EXPIRES_IN=7d

# Browser origins allowed by CORS (REST API and Socket.IO), comma-separated, scheme + host (+ port), no path.
# Unknown origins are refused. If empty: development allows localhost:3000/5173, production allows nothing.
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Email for verification and password reset codes (Nodemailer, SMTP).
# Gmail needs only these three: SMTP_USER=<full Gmail address>, SMTP_PASS=<16-letter App Password> (requires
# 2-Step Verification: https://myaccount.google.com/apppasswords; the normal Gmail password is rejected),
# EMAIL_FROM. The server is then smtp.gmail.com:587 with STARTTLS.
SMTP_USER=<your_address@gmail.com>
SMTP_PASS=<16_letter_app_password>
EMAIL_FROM="Circlo <your_address@gmail.com>"
# Production on a free Render web service: outbound SMTP (ports 25/465/587) is blocked there, so send through
# Brevo's HTTPS API instead. With BREVO_API_KEY set, SMTP_* are ignored; EMAIL_FROM must be a sender verified in
# Brevo (Senders, Domains & Dedicated IPs -> Senders). Key: Brevo -> SMTP & API -> API keys.
# BREVO_API_KEY=<brevo_api_key>
# Other providers: also set SMTP_HOST and SMTP_PORT (465 = implicit TLS, anything else = STARTTLS)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Optional: name shown in the emails (default "AI-Powered Social Media Platform")
# APP_NAME=AI-Powered Social Media Platform
# Optional: secret for hashing one-time codes (defaults to JWT_SECRET). Generate like JWT_SECRET.
OTP_SECRET=

# AI model (Ollama): moderation of every post/comment, rewrite suggestions, summaries, post writing help.
# Posts and comments are refused (503) while the model is unavailable: moderation never fails open.
#
# Ollama Cloud (production on Render, and development without a local model). API key: ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=<ollama_cloud_api_key>
OLLAMA_MODEL=gemma4:31b
#
# Local Ollama instead (development only; https://ollama.com/download, then "ollama pull <model>"):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma3:4b
#
# Optional tuning (defaults shown)
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=2
OLLAMA_MAX_CONCURRENCY=4
OLLAMA_NUM_CTX=8192
# Local Ollama only: how long the model stays in memory after a request
OLLAMA_KEEP_ALIVE=30m
